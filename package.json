{
  "name": "nekomimi-asmr-media-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/server/index.js",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev -- --host",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "reset-auth": "tsx server/reset-auth.ts --yes",
    "test": "NODE_ENV=test vitest run --config ./vitest.config.ts",
    "test:watch": "NODE_ENV=test vitest --config ./vitest.config.ts",
    "test:coverage": "NODE_ENV=test vitest run --config ./vitest.config.ts --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "express": "^5.0.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "node-html-parser": "^9.0.4",
    "sql.js": "^1.12.0",
    "swagger-ui-express": "^5.0.1",
    "tunnel-agent": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
